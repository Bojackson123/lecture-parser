      {
        "type": "paragraph",
        "paragraph": {
          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "The value of a state is the immediate reward plus gamma times the expected value of wherever you land next. The equation is recursive: the value on the left shows up again on the right-hand side."
              }
            }
          ]
        }
      },
      {
        "type": "equation",
        "equation": {
          "expression": "V(s) = \\max_a \\Big[ R(s, a) + \\gamma \\sum_{s'} T(s, a, s')\\, V(s') \\Big]"
        }
      },
