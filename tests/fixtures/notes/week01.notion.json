      {
        "type": "paragraph",
        "paragraph": {
          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "Now allow one reroll. The trick is to value the second roll first, because its worth is already known: keep the first roll only if it beats 3.5, i.e. a 4, 5 or 6."
              }
            }
          ]
        }
      },
      {
        "type": "equation",
        "equation": {
          "expression": "\\mathbb{E}[\\text{reroll game}] = \\tfrac{1}{2}\\cdot\\tfrac{4+5+6}{3} + \\tfrac{1}{2}\\cdot 3.5 = 4.25"
        }
      },
      {
        "type": "callout",
        "callout": {
          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "This is dynamic programming in miniature: solve the last decision first, then use its value to make the earlier one. The same idea drives value iteration."
              }
            }
          ],
          "icon": {
            "type": "emoji",
            "emoji": "💡"
