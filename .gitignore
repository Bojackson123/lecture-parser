# Python bytecode
__pycache__/
*.py[cod]

# Secrets — .env.example is the committed template
.env

# Environments and tool caches
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Build artefacts
dist/
*.egg-info/
.hypothesis/

# The default output workspace (`build`/`serve` -o): week JSONs, media/, the
# response .cache/ and web uploads/ all live here and never belong in git.
# Anchored to the repo root so tests/fixtures/notes/ stays unaffected.
/notes/
