# Copy to .env and fill in. .env is gitignored — never commit real tokens.
# The CLI seeds missing environment variables from ./.env at startup; a variable
# already set in the real environment always wins.

# Anthropic API key — consulted only by a real `lecturenotes build` generation call.
ANTHROPIC_API_KEY=sk-ant-...

# Notion internal integration secret — read only by `lecturenotes push`, at run time.
# Create one at https://www.notion.so/my-integrations and share the target page with it.
NOTION_TOKEN=ntn_...
